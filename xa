#!/usr/bin/env bash
#
# chores.sh/xa
# @github.com/amekusa/chores.sh
#

_main() (
	shopt -s dotglob nullglob # glob options

	local this="${BASH_SOURCE[0]##*/}"
	local this_dir="$(dirname "${BASH_SOURCE[0]}")"

	if [[ $# = 0 || "$1" = "--help" || "$1" = "-h" ]]; then
		cat <<- EOF
		$this
		Extracts an archive.

		Usage:
		  $this <archive>

		EOF
		return 1
	fi

	local src="$1"
	if [[ ! -e "$src" ]]; then
		printf "[Error] No such file as '%s'.\n" "$src" >&2
		return 1
	fi
	if [[ ! -f "$src" ]]; then
		printf "[Error] Invalid file: '%s'.\n" "$src" >&2
		return 1
	fi
	if [[ ! "$src" =~ ^(.*[^/])(\.(zip|7z|rar|tar\.t?(gz|xz|bz2?)))$ ]]; then
		printf "[Error] Unsupported file: '%s'.\n" "$src" >&2
		return 1
	fi
	local ext="${BASH_REMATCH[3]}"
	local dst="${BASH_REMATCH[1]}"
	local dst_dir="$(dirname "$dst")"

	# create tempdir ('X's are replaced with random chars)
	local temp; temp="$(mktemp -d "$dst_dir/.extract_XXXXXXXXXX")" || {
		printf "[Error] Failed to create temporary directory.\n" >&2
		return 1
	}

	# delete tempdir on exit
	trap 'rm -rf -- "$temp"' EXIT

	# extract into tempdir
	printf "Extracting '%s'...\n" "$src"
	if ! case "$ext" in
		tar.*) tar xf "$src" -C "$temp" ;;
		zip)   unzip "$src" -d "$temp" ;;
		rar)   unrar x "$src" "$temp" ;;
		7z)    7z x "$src" -o"$temp" ;;
	esac; then
		printf "[Error] Failed to extract '%s'.\n" "$src" >&2
		return 1
	fi
	local result="$temp"
	local results=("$temp"/*)

	# if the result is only one top-level directory
	if [[ ${#results[@]} -eq 1 && -d "${results[0]}" && ! -L "${results[0]}" ]]; then
		result="${results[0]}"
		dst="$dst_dir/${results[0]##*/}"
	fi

	# check destination
	local merge=false
	while true; do
		if [[ -e "$dst" ]]; then
			if [[ -d "$dst" ]]; then
				if [[ -L "$dst" ]]
					then printf "Destination already exists (symlink): '%s'.\n" "$dst"
					else printf "Destination already exists: '%s'.\n" "$dst"
				fi
				local answer
				read -n 1 -p "Choose action: [D]elete / [M]erge / [C]ancel > " answer || answer=C; echo
				case "$answer" in
				[Dd])
					if ! rm -rf -- "$dst"; then
						printf "[Error] Failed to delete '%s'.\n" "$dst" >&2
						return 1
					fi
					printf "Deleted '%s'.\n" "$dst"
					break
					;;
				[Mm])
					merge=true
					break
					;;
				[Cc])
					printf "Cancelled.\n"
					return 1
					;;
				*)
					printf "Answer with D, M or C.\n"
					;;
				esac
			else
				printf "[Error] Destination already exists (non-directory): '%s'.\n" "$dst" >&2
				return 1
			fi

		elif [[ -L "$dst" ]]; then
			printf "[Error] Destination already exists (deadlink): '%s'.\n" "$dst" >&2
			return 1

		else
			break
		fi
	done

	if $merge; then
		rsync -a -- "$result/" "$dst" || {
			printf "[Error] Failed to merge the result into '%s'.\n" "$dst" >&2
			return 1
		}
	else
		mv -- "$result" "$dst" || {
			printf "[Error] Failed to move the result to '%s'.\n" "$dst" >&2
			return 1
		}
	fi

	printf "Extraction complete.\n"
	printf " - src: '%s'\n" "$src"
	printf " - dst: '%s'\n" "$dst"

	while true; do
		local answer
		read -n 1 -p "Copy the destination to clipboard? [Y/N] > " answer || answer=N; echo
		case "$answer" in
		[Yy])
			"$this_dir/cb" "$dst" || {
				printf "[Error] Failed to copy '%s' to clipboard.\n" "$dst" >&2
				return 1
			}
			printf "Copied '%s' to clipboard.\n" "$dst"
			break
			;;
		[Nn])
			:
			break
			;;
		*)
			printf "Answer with Y or N.\n"
			;;
		esac
	done
)

_main "$@"

