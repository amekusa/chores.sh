#!/usr/bin/env bash
#
# chores.sh/cb
# @github.com/amekusa/chores.sh
#

_main() {
	local this="${BASH_SOURCE[0]##*/}"
	if [ $# -eq 0 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
		cat <<- EOF
		Copies a string to clipboard.

		Usage:
		  $this <string>

		EOF
		return 1
	fi
	if command -v "pbcopy" &> /dev/null; then # mac
		printf "$*" | pbcopy
	elif command -v "xclip" &> /dev/null; then # x11
		printf "$*" | xclip
	elif command -v "wl-copy" &> /dev/null; then # wayland
		printf "$*" | wl-copy
	elif command -v "clip" &> /dev/null; then # windows
		printf "$*" | clip
	else
		printf "[Error] $this: No command available.\n" >&2
		return 1
	fi
}

_main "$@"

