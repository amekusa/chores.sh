#!/usr/bin/env bash
#
# chores.sh/cb
# @github.com/amekusa/chores.sh
#

_main() {
	local this="${BASH_SOURCE[0]##*/}"
	if [ $# -eq 0 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
		cat <<- EOF
		Copies a string to clipboard.

		Usage:
		  $this <string>

		EOF
		return 1
	fi
	local cmd
	case "$(uname -s)" in
	Darwin)
		cmd=pbcopy
		;;
	Linux)
		case "${XDG_SESSION_TYPE:-}" in
		x11)
			cmd=xclip
			;;
		wayland)
			cmd=wl-copy
			;;
		esac
		;;
	*)
		cmd=clip
		;;
	esac

	if [[ -n "$cmd" ]] && command -v "$cmd" &>/dev/null; then
		printf '%s' "$*" | $cmd
	else
		# use OSC 52 escape sequence
		local b64="$(printf '%s' "$*" | base64 -w 0)"
		if [[ -n "$TMUX" ]]; then
			printf '\ePtmux;\e\e]52;c;%s\a\e\\' "$b64"
		else
			printf '\e]52;c;%s\a' "$b64"
		fi
	fi
}

_main "$@"

